# Copy this file to .env.local and fill in the values.

# ── Auth ─────────────────────────────────────────────────────────────────────
AUTH_SECRET=
AUTH_URL=
# Set to 'true' to disable rate limiting. Use in local dev and E2E only. Never in production.
# THROTTLE_DISABLED=true

# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=

# ── Email — e2e testing (Mailpit, via docker-compose) ────────────────────────
# Mailpit runs on localhost:1025 (SMTP) and localhost:8025 (Web UI).
# playwright.config.ts injects these automatically — no manual config needed.
# View captured emails at http://localhost:8025 while running e2e tests.

# ── Email — development (MailTrap) ───────────────────────────────────────────
EMAIL_PROVIDER=
MAILTRAP_HOST=
MAILTRAP_PORT=
MAILTRAP_USER=
MAILTRAP_PASS=
SMTP_FROM=

# ── Email — production (Mailgun / SMTP) ──────────────────────────────────────
# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# ── File Upload — development (MinIO) ────────────────────────────────────────
UPLOAD_PROVIDER=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_PUBLIC_URL=

# ── File Upload — production (Cloudinary) ────────────────────────────────────
# UPLOAD_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── FatSecret Platform API (server-side only — never expose to client) ────────
# Register at https://platform.fatsecret.com/platform-api
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
