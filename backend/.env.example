PORT=3001
# Set to 'true' to disable rate limiting. Use in local dev and E2E environments only.
# Default: off (rate limiting enabled). Never set this in production.
# THROTTLE_DISABLED=true
MONGODB_URI=mongodb://user:pass@localhost:27017/power_gym?authSource=admin
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# DEV ONLY: set to '1' to expose the password reset token in the forgot-password response.
# Never set this in production — it is an account-takeover risk.
AUTH_EXPOSE_RESET_TOKEN=1

# Application URL (used for email links)
APP_URL=http://localhost:3001

# Email — set EMAIL_PROVIDER=smtp (default), mailtrap, or mailgun
EMAIL_PROVIDER=smtp
SMTP_FROM=noreply@powergym.app
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# Mailtrap (EMAIL_PROVIDER=mailtrap)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=
# Mailgun (EMAIL_PROVIDER=mailgun)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Storage — MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=power-gym
MINIO_PUBLIC_URL=http://localhost:9000
